# ============================================================
# TravelMind backend configuration
# Copy this file to ".env" and fill in your FREE API keys.
# Every key below has a free tier that needs no credit card.
# ============================================================

# ---- LLM PROVIDER ------------------------------------------------
# Choose which free LLM powers the agents: "groq" or "gemini"
LLM_PROVIDER=groq

# Groq: free, very fast Llama 3.3 / 70B inference.
# Get a free key -> https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini: free tier (Gemini 1.5/2.0 Flash).
# Get a free key -> https://aistudio.google.com/apikey
# NOTE: this codebase auto-detects a working model for your key at startup,
# so this value is just a *preferred* model - it's fine to leave as-is.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- REAL-TIME DATA SOURCES (all free, most need no key) --------
# Weather + Geocoding: Open-Meteo -> https://open-meteo.com (NO key required)
# Currency exchange: open.er-api.com (NO key required)
# Live web grounding: DuckDuckGo search via `ddgs` (NO key required)

# ---- APP SETTINGS -------------------------------------------------
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REQUEST_TIMEOUT_SECONDS=30
